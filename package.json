{
  "name": "neonplay",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "setup": "node scripts/setup-local.mjs",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server && npm run test -w client",
    "test:coverage": "npm run test:coverage -w server && npm run test:coverage -w client",
    "start": "npm run start -w server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "prisma@6.19.0": true,
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "@tailwindcss/oxide@4.1.13": true
  }
}
